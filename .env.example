DATABASE_URL=postgresql+asyncpg://alay:alay@localhost:5433/alay
TEST_DATABASE_URL=postgresql+asyncpg://alay:alay@localhost:5433/alay_test
ADAPTERS_FILE=adapters.yaml
LOGIN_ALLOWED_HOSTS=mock-vfs,localhost
MOCK_VFS_EMAIL=demo@alay.test
MOCK_VFS_PASSWORD=demo-password
LOG_LEVEL=INFO
DEFAULT_INTERVAL_MINUTES=60
SCHEDULER_TICK_S=5
WORKER_CONCURRENCY=3
CHECK_TIMEOUT_S=90
CHECK_TOTAL_TIMEOUT_S=150
RETRY_ATTEMPTS=3
RETRY_WAIT_BASE_S=2
JOB_LEASE_S=180
MAX_CLAIMS=3
EXECUTOR_IDLE_S=1
HEARTBEAT_S=15
SHUTDOWN_GRACE_S=60
MANUAL_WAIT_S=60
MIN_CHECKS_FOR_STATS=5
LIVE_CHECKS_ENABLED=true
HEADFUL=false
EVIDENCE_DIR=./data/evidence
# Host port for the api container in docker compose (default 8000)
API_PORT=8000
